#!/bin/sh
set -eu

chmod 0755 /usr/local/bin/reboot-launcher
chmod 0755 /usr/local/lib/reboot/setup-desktop
chmod 0755 /opt/reboot/app/main.py
chmod 0755 /etc/skel/Desktop/*.desktop
systemctl enable lightdm.service
systemctl enable ssh.service
systemctl enable 'mnt-reboot\x2dapp.automount'
systemd-tmpfiles --create /usr/lib/tmpfiles.d/reboot.conf
